<% layout("./layouts/boilermain" , {user: user}) -%>

<div class="ayurvedic-remedies-page">
    <div class="container">
        <div class="ayurvedic-page-header">
            <h1 class="ayurvedic-page-title">Ayurvedic Home Remedies</h1>
            <p class="ayurvedic-page-subtitle">Discover natural healing solutions from ancient Ayurvedic wisdom</p>
            <button class=" addbtn btn-ayurveda"> <i class="fas fa-leaf"></i><a href="/ayaush/remedi"><b>ADD New HOME REMEDIES</b></a></button>
        </div>

        <% alldata.forEach(item => { %>
            <div class="remedy-card">
                <div class="remedy-header">
                    <div class="remedy-image-container">
                        <img src="<%= item.image%>" alt="<%= item.title %>" class="remedy-image">
                    </div>
                    <div class="remedy-header-content">
                        <h2 class="remedy-title"><%= item.title %></h2>
                        <span class="remedy-category"><i class="fas fa-leaf"></i> <%= item.category %></span>
                        <p class="remedy-description"><%= item.description %></p>
                    </div>
                </div>

                <div class="remedy-content">
                    <div class="remedy-section">
                        <h3 class="remedy-section-title">
                            <i class="fas fa-star"></i> Benefits
                        </h3>
                        <ul class="remedy-list">
                            <% item.benefits.forEach(b => { %>
                                <li><%= b %></li>
                            <% }) %>
                        </ul>
                    </div>

                    <div class="remedy-section">
                        <h3 class="remedy-section-title">
                            <i class="fas fa-seedling"></i> Ingredients
                        </h3>
                        <ul class="remedy-list">
                            <% item.ingredients.forEach(ing => { %>
                                <li><%= ing %></li>
                            <% }) %>
                        </ul>
                    </div>
                </div>

                <div class="remedy-usage">
                    <h3 class="remedy-section-title">
                        <i class="fas fa-book-medical"></i> Usage Instructions
                    </h3>
                    <p class="remedy-text"><%= item.usage %></p>
                </div>

                <div class="remedy-precautions">
                    <h3 class="remedy-section-title">
                        <i class="fas fa-exclamation-triangle"></i> Precautions
                    </h3>
                    <p class="remedy-text"><%= item.precautions %></p>
                </div>
                <br>
                <form   method="post"action="/ayaush/<%=item.id%>?_method=delete" >
                   <button class="remedy-category"><i class="fas fa-leaf"></i>Delete</button>
                </form>
            </div>
        <% }) %>
    </div>
</div>

