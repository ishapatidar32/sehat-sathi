<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SEHAT SATHI</title>
        <link rel="stylesheet" href="/css/stylemain.css" />
            <link 
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" 
        rel="stylesheet" 
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" 
        crossorigin="anonymous" >
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">
<link rel="icon" href="/images/logo.png" />
</head>
<body>
        <%- include("../includes/navbarmain.ejs", {user : user }) %>
        <div class = "container">
      <%-body%>
      <%- include("../includes/footer.ejs") %>
</div>
        <!-- Chatbot Widget -->
        <div id="sehat-chatbot" class="sehat-chatbot hidden">
            <div class="chatbot-header">
                <div class="title"><i class="fas fa-stethoscope me-2"></i>Sehat Sathi Assistant</div>
                <button id="chatbot-close" class="icon-btn" aria-label="Close">✕</button>
            </div>
            <div class="chatbot-body" id="chatbot-messages" aria-live="polite"></div>
            <div class="chatbot-footer">
                <input id="chatbot-input" type="text" class="chatbot-input" placeholder="Describe your symptoms (e.g., fever for 2 days, cough)" />
                <button id="chatbot-send" class="btn btn-ai">Send</button>
            </div>
        </div>
        <button id="chatbot-launch" class="chatbot-fab btn btn-ai" aria-label="Open Sehat Sathi Assistant">
            <i class="fas fa-comments"></i>
        </button>
        <script src="/chatbot.js"></script>
     <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>