<% layout("/layouts/boilerplate") %>

<!-- Hero Section -->
<div class="hero-container">
    <div class="hero-section">
        <div class="hero-content">
            <h1 class="hero-title">SehatSathi</h1>
            <p class="hero-subtitle">Your Digital Healthcare Companion - Connecting Rural Communities to Quality Healthcare</p>
            <div class="hero-buttons">
                <a href="/user/login" class="hero-btn hero-btn-primary">Login</a>
                <a href="/user/register" class="hero-btn hero-btn-secondary">Register</a>
            </div>
        </div>
    </div>
</div>

<!-- Features Section -->
<section class="features-section py-5">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-12">
                <h2 class="section-title">Revolutionizing Rural Healthcare</h2>
                <p class="section-subtitle">Bridging the gap between patients and quality healthcare through technology</p>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-video"></i>
                    </div>
                    <h4>Telemedicine Consultations</h4>
                    <p>Connect with certified doctors through video, audio, or text consultations from the comfort of your home.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-robot"></i>
                    </div>
                    <h4>AI-Powered Diagnosis</h4>
                    <p>Advanced AI processes symptoms and provides preliminary diagnosis with triage recommendations.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-language"></i>
                    </div>
                    <h4>Multi-Language Support</h4>
                    <p>Available in Punjabi, Hindi, and English to serve diverse rural communities effectively.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-pills"></i>
                    </div>
                    <h4>Digital Prescription</h4>
                    <p>Receive digital prescriptions and access to verified traditional remedies library.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <h4>Appointment Management</h4>
                    <p>Easy scheduling and management of appointments with healthcare providers.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-mobile-alt"></i>
                    </div>
                    <h4>Mobile Accessibility</h4>
                    <p>Access healthcare services through phone, ABHA ID, or any mobile device.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Workflow Section -->
<section class="workflow-section py-5 bg-light">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-12">
                <h2 class="section-title">How SehatSathi Works</h2>
                <p class="section-subtitle">Our comprehensive telemedicine platform workflow</p>
            </div>
        </div>
        
        <!-- Patient Journey -->
        <div class="workflow-container mb-5">
            <h3 class="workflow-title text-center mb-4">Patient Journey</h3>
            <div class="workflow-steps">
                <div class="workflow-step">
                    <div class="step-icon patient-step">
                        <i class="fas fa-user-plus"></i>
                    </div>
                    <div class="step-content">
                        <h5>Registration</h5>
                        <p>Patient logs in or registers via phone or ABHA ID</p>
                    </div>
                </div>
                <div class="workflow-arrow">→</div>
                <div class="workflow-step">
                    <div class="step-icon ai-step">
                        <i class="fas fa-brain"></i>
                    </div>
                    <div class="step-content">
                        <h5>AI Processing</h5>
                        <p>AI processes symptoms through language AI, symptom checker, and triage AI</p>
                    </div>
                </div>
                <div class="workflow-arrow">→</div>
                <div class="workflow-step">
                    <div class="step-icon symptoms-step">
                        <i class="fas fa-notes-medical"></i>
                    </div>
                    <div class="step-content">
                        <h5>Symptom Entry</h5>
                        <p>Patient enters symptoms in Punjabi, Hindi, or English</p>
                    </div>
                </div>
                <div class="workflow-arrow">→</div>
                <div class="workflow-step">
                    <div class="step-icon consultation-step">
                        <i class="fas fa-video"></i>
                    </div>
                    <div class="step-content">
                        <h5>Teleconsultation</h5>
                        <p>Patient books appointment and consults with doctor via video, audio, or text</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Doctor Journey -->
        <div class="workflow-container">
            <h3 class="workflow-title text-center mb-4">Doctor Journey</h3>
            <div class="workflow-steps">
                <div class="workflow-step">
                    <div class="step-icon doctor-step">
                        <i class="fas fa-user-md"></i>
                    </div>
                    <div class="step-content">
                        <h5>Doctor Login</h5>
                        <p>Doctor logs in or registers to the platform</p>
                    </div>
                </div>
                <div class="workflow-arrow">→</div>
                <div class="workflow-step">
                    <div class="step-icon appointment-step">
                        <i class="fas fa-calendar"></i>
                    </div>
                    <div class="step-content">
                        <h5>Manage Appointments</h5>
                        <p>Doctor views and manages appointments</p>
                    </div>
                </div>
                <div class="workflow-arrow">→</div>
                <div class="workflow-step">
                    <div class="step-icon consult-step">
                        <i class="fas fa-stethoscope"></i>
                    </div>
                    <div class="step-content">
                        <h5>Patient Consultation</h5>
                        <p>Doctor consults with patients via video, audio, or text</p>
                    </div>
                </div>
                <div class="workflow-arrow">→</div>
                <div class="workflow-step">
                    <div class="step-icon treatment-step">
                        <i class="fas fa-prescription"></i>
                    </div>
                    <div class="step-content">
                        <h5>Treatment & Records</h5>
                        <p>Doctor suggests treatments, adds remedies to library, and updates patient records</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- About Section -->
<section class="about-section py-5 bg-light">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="section-title">About SehatSathi</h2>
                <p class="about-text">
                    SehatSathi is a revolutionary telemedicine platform designed specifically for rural communities. 
                    We leverage cutting-edge AI technology and multilingual support to bridge the healthcare gap 
                    between urban and rural areas.
                </p>
                <p class="about-text">
                    Our platform combines traditional remedies with modern medical practices, ensuring culturally 
                    sensitive healthcare delivery that resonates with rural populations while maintaining the 
                    highest medical standards.
                </p>
                <div class="about-features">
                    <div class="about-feature">
                        <i class="fas fa-check-circle"></i>
                        <span>AI-Powered Symptom Analysis</span>
                    </div>
                    <div class="about-feature">
                        <i class="fas fa-check-circle"></i>
                        <span>Multi-Language Support</span>
                    </div>
                    <div class="about-feature">
                        <i class="fas fa-check-circle"></i>
                        <span>Traditional & Modern Medicine</span>
                    </div>
                    <div class="about-feature">
                        <i class="fas fa-check-circle"></i>
                        <span>24/7 Healthcare Access</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="about-image">
                    <i class="fas fa-heartbeat about-icon"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section py-5">
    <div class="container text-center">
        <h2 class="cta-title">Ready to Transform Rural Healthcare?</h2>
        <p class="cta-subtitle">Join thousands of patients and doctors already using SehatSathi</p>
        <div class="cta-buttons">
            <a href="/user/register" class="btn cta-btn-primary">Get Started Today</a>
            <a href="#" class="btn cta-btn-secondary">Learn More</a>
        </div>
    </div>
</section>
