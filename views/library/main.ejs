<% layout("./layouts/boilermain" , {user: user}) -%>


<!-- Quick Actions -->
<section class="quick-actions py-4">
    <div class="container">
        <div class="row g-3">
            <div class="col-lg-3 col-md-6">
                <div class="action-card ai-diagnosis">
                    <div class="card-icon">
                        <i class="fas fa-brain"></i>
                    </div>
                    <h5>AI Health Check</h5>
                    <p>Instant symptom analysis</p>
                    <button class="btn btn-ai" id="start-analysis">Start Analysis</button>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="action-card telemedicine">
                    <div class="card-icon">
                        <i class="fas fa-video"></i>
                    </div>
                    <h5>Video Consultation</h5>
                    <p>Consult with certified doctors</p>
                    <button class="btn btn-telemedicine">Book Appointment</button>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="action-card ayurveda">
                    <div class="card-icon">
                        <i class="fas fa-leaf"></i>
                    </div>
                    <h5>Ayurveda Consultation</h5>
                    <p>AYUSH certified practitioners</p>
                    <button class="btn btn-ayurveda"><a href="/ayaush">Explore Ayurveda</a></button>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="action-card emergency">
                    <div class="card-icon">
                        <i class="fas fa-ambulance"></i>
                    </div>
                    <h5>Emergency Consultation</h5>
                    <p>24/7 immediate medical help</p>
                    <button class="btn btn-emergency">Connect Now</button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Main Dashboard Content -->
<div class="dashboard-content">
    <div class="container">
        <div class="row">
            <!-- Left Column -->
            <div class="col-lg-8">
                <!-- Telemedicine Section -->
                <section class="dashboard-section">
                    <div class="section-header">
                        <h3><i class="fas fa-stethoscope me-2"></i>Telemedicine Services</h3>
                        <span class="section-badge">Available 24/7</span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="service-card">
                                <div class="service-icon video-consultation">
                                    <i class="fas fa-video"></i>
                                </div>
                                <div class="service-content">
                                    <h5>Video Consultation</h5>
                                    <p>Face-to-face consultation with doctors via video call</p>
                                    <ul class="service-features">
                                        <li>HD Video Quality</li>
                                        <li>Screen Sharing</li>
                                        <li>Multi-language Support</li>
                                    </ul>
                                    <button class="btn btn-outline-primary btn-sm">Book Now</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="service-card">
                                <div class="service-icon audio-consultation">
                                    <i class="fas fa-phone"></i>
                                </div>
                                <div class="service-content">
                                    <h5>Audio Consultation</h5>
                                    <p>Voice-based consultation for privacy and convenience</p>
                                    <ul class="service-features">
                                        <li>Crystal Clear Audio</li>
                                        <li>Lower Data Usage</li>
                                        <li>Rural Connectivity Friendly</li>
                                    </ul>
                                    <button class="btn btn-outline-primary btn-sm">Call Doctor</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="service-card">
                                <div class="service-icon text-consultation">
                                    <i class="fas fa-comments"></i>
                                </div>
                                <div class="service-content">
                                    <h5>Text Consultation</h5>
                                    <p>Chat-based consultation with medical professionals</p>
                                    <ul class="service-features">
                                        <li>Instant Messaging</li>
                                        <li>File Sharing</li>
                                        <li>Prescription Upload</li>
                                    </ul>
                                    <button class="btn btn-outline-primary btn-sm">Start Chat</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="service-card">
                                <div class="service-icon specialist-consultation">
                                    <i class="fas fa-user-md"></i>
                                </div>
                                <div class="service-content">
                                    <h5>Specialist Consultation</h5>
                                    <p>Connect with specialists for complex conditions</p>
                                    <ul class="service-features">
                                        <li>Cardiology</li>
                                        <li>Dermatology</li>
                                        <li>Pediatrics</li>
                                    </ul>
                                    <button class="btn btn-outline-primary btn-sm">Find Specialist</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Ayurveda Section -->
                <section class="dashboard-section">
                    <div class="section-header">
                        <h3><i class="fas fa-leaf me-2"></i>AYUSH Certified Ayurveda</h3>
                        <span class="section-badge ayush-certified">AYUSH Certified</span>
                    </div>
                    <div class="ayurveda-content">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="ayurveda-card">
                                    <div class="ayurveda-icon">
                                        <i class="fas fa-seedling"></i>
                                    </div>
                                    <h5>Herbal Medicines</h5>
                                    <p>Certified Ayurvedic medicines from AYUSH approved manufacturers</p>
                                    <div class="ayurveda-features">
                                        <span class="feature-tag">GMP Certified</span>
                                        <span class="feature-tag">Lab Tested</span>
                                        <span class="feature-tag">Organic</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="ayurveda-card">
                                    <div class="ayurveda-icon">
                                        <i class="fas fa-spa"></i>
                                    </div>
                                    <h5>Panchakarma Therapy</h5>
                                    <p>Traditional detoxification and rejuvenation treatments</p>
                                    <div class="ayurveda-features">
                                        <span class="feature-tag">Authentic</span>
                                        <span class="feature-tag">Personalized</span>
                                        <span class="feature-tag">Holistic</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="ayurveda-card">
                                    <div class="ayurveda-icon">
                                        <i class="fas fa-balance-scale"></i>
                                    </div>
                                    <h5>Dosha Analysis</h5>
                                    <p>Personalized constitution analysis by qualified Ayurveda doctors</p>
                                    <div class="ayurveda-features">
                                        <span class="feature-tag">Vata</span>
                                        <span class="feature-tag">Pitta</span>
                                        <span class="feature-tag">Kapha</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="ayurveda-card">
                                    <div class="ayurveda-icon">
                                        <i class="fas fa-mortar-pestle"></i>
                                    </div>
                                    <h5>Traditional Remedies</h5>
                                    <p>Time-tested home remedies and lifestyle recommendations</p>
                                    <div class="ayurveda-features">
                                        <span class="feature-tag">Natural</span>
                                        <span class="feature-tag">Safe</span>
                                        <span class="feature-tag">Effective</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="ayush-certification">
                            <div class="certification-badge">
                                <i class="fas fa-certificate"></i>
                                <div class="certification-text">
                                    <strong>AYUSH Ministry Certified</strong>
                                    <p>All practitioners and medicines are certified by Ministry of AYUSH, Government of India</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Health Records Section -->
                <section class="dashboard-section">
                    <div class="section-header">
                        <h3><i class="fas fa-file-medical me-2"></i>Health Records</h3>
                        <a href="#" class="section-link">View All</a>
                    </div>
                    <div class="health-records">
                        <div class="record-item">
                            <div class="record-icon">
                                <i class="fas fa-heartbeat"></i>
                            </div>
                            <div class="record-content">
                                <h6>Last Consultation</h6>
                                <p>Dr. Rajesh Kumar - General Medicine</p>
                                <span class="record-date">2 days ago</span>
                            </div>
                        </div>
                        <div class="record-item">
                            <div class="record-icon">
                                <i class="fas fa-prescription-bottle"></i>
                            </div>
                            <div class="record-content">
                                <h6>Current Medications</h6>
                                <p>Ashwagandha, Triphala, Amla</p>
                                <span class="record-date">Active</span>
                            </div>
                        </div>
                        <div class="record-item">
                            <div class="record-icon">
                                <i class="fas fa-vial"></i>
                            </div>
                            <div class="record-content">
                                <h6>Lab Reports</h6>
                                <p>Blood Test, Urine Analysis</p>
                                <span class="record-date">1 week ago</span>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <!-- Right Column -->
            <div class="col-lg-4">
                <!-- Upcoming Appointments -->
                <section class="dashboard-section">
                    <div class="section-header">
                        <h4><i class="fas fa-calendar me-2"></i>Upcoming Appointments</h4>
                    </div>
                    <div class="appointments-list">
                        <div class="appointment-card">
                            <div class="appointment-time">
                                <span class="time">2:30 PM</span>
                                <span class="date">Today</span>
                            </div>
                            <div class="appointment-details">
                                <h6>Dr. Priya Sharma</h6>
                                <p>Ayurveda Consultation</p>
                                <span class="appointment-type video">Video Call</span>
                            </div>
                        </div>
                        <div class="appointment-card">
                            <div class="appointment-time">
                                <span class="time">10:00 AM</span>
                                <span class="date">Tomorrow</span>
                            </div>
                            <div class="appointment-details">
                                <h6>Dr. Amit Patel</h6>
                                <p>Follow-up Consultation</p>
                                <span class="appointment-type audio">Audio Call</span>
                            </div>
                        </div>
                    </div>
                    <button class="btn btn-primary w-100 mt-3">Book New Appointment</button>
                </section>

                <!-- Health Tips -->
                <section class="dashboard-section">
                    <div class="section-header">
                        <h4><i class="fas fa-lightbulb me-2"></i>Daily Health Tips</h4>
                    </div>
                    <div class="health-tips">
                        <div class="tip-card">
                            <div class="tip-icon">
                                <i class="fas fa-sun"></i>
                            </div>
                            <div class="tip-content">
                                <h6>Morning Routine</h6>
                                <p>Start your day with warm lemon water and 10 minutes of pranayama</p>
                            </div>
                        </div>
                        <div class="tip-card">
                            <div class="tip-icon">
                                <i class="fas fa-apple-alt"></i>
                            </div>
                            <div class="tip-content">
                                <h6>Seasonal Diet</h6>
                                <p>Include fresh seasonal fruits and vegetables in your daily meals</p>
                            </div>
                        </div>
                        <div class="tip-card">
                            <div class="tip-icon">
                                <i class="fas fa-moon"></i>
                            </div>
                            <div class="tip-content">
                                <h6>Better Sleep</h6>
                                <p>Practice meditation before bed and avoid screens 1 hour before sleeping</p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Emergency Contacts -->
                <section class="dashboard-section">
                    <div class="section-header">
                        <h4><i class="fas fa-phone-alt me-2"></i>Emergency Contacts</h4>
                    </div>
                    <div class="emergency-contacts">
                        <div class="contact-item">
                            <div class="contact-icon emergency">
                                <i class="fas fa-ambulance"></i>
                            </div>
                            <div class="contact-details">
                                <h6>Emergency Ambulance</h6>
                                <p class="contact-number">108</p>
                            </div>
                            <button class="btn btn-sm btn-emergency">Call</button>
                        </div>
                        <div class="contact-item">
                            <div class="contact-icon doctor">
                                <i class="fas fa-user-md"></i>
                            </div>
                            <div class="contact-details">
                                <h6>24/7 Doctor Helpline</h6>
                                <p class="contact-number">+91 98765 43210</p>
                            </div>
                            <button class="btn btn-sm btn-primary">Call</button>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
  </div>